#!/bin/sh
set -eu
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# linuxdeploy sets origin-relative ELF RUNPATHs and qt.conf. Do not export
# bundled Qt/library paths into unrelated host applications opened by links.
unset LD_LIBRARY_PATH QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH
unset QML_IMPORT_PATH QML2_IMPORT_PATH
unset QTWEBENGINEPROCESS_PATH QTWEBENGINE_RESOURCES_PATH QTWEBENGINE_LOCALES_PATH
export GSETTINGS_SCHEMA_DIR="$here/usr/share/glib-2.0/schemas"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
exec "$here/usr/bin/gonnect" "$@"
