FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
COPY *.deb /packages/
RUN apt-get update && apt-get install -y --no-install-recommends \
    /packages/*.deb dbus-x11 xvfb xauth desktop-file-utils xdotool python3 \
    && rm -rf /var/lib/apt/lists/* /packages \
    && useradd --create-home tester
COPY qml-runtime.json /usr/local/share/gonnect-qml-runtime.json
COPY smoke.sh /usr/local/bin/gonnect-smoke
USER tester
WORKDIR /home/tester
CMD ["bash", "/usr/local/bin/gonnect-smoke"]
