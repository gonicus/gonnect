diff -Naur a/pjsip/src/pjsua-lib/pjsua_call.c b/pjsip/src/pjsua-lib/pjsua_call.c
--- a/pjsip/src/pjsua-lib/pjsua_call.c	2026-04-22 08:47:35.000000000 +0200
+++ b/pjsip/src/pjsua-lib/pjsua_call.c	2026-07-29 16:11:36.158651484 +0200
@@ -838,9 +838,18 @@
 
     /* When contact is changed, the account transport may have been
      * changed too, so let's update the dialog's transport too.
-     */
-    pjsua_init_tpselector(call->acc_id, &tp_sel);
-    pjsip_dlg_set_transport(call->inv->dlg, &tp_sel);
+     *
+     * Exception: if the dialog has been explicitly pinned to a specific
+     * connection (PJSIP_TPSELECTOR_TRANSPORT, e.g. set by the application so
+     * that in-dialog requests stay on the connection the call was established
+     * on - required by Cisco Unified CM, which advertises a Contact address
+     * that does not resolve to the registered connection), keep that binding
+     * instead of falling back to the account's listener.
+     */
+    if (call->inv->dlg->tp_sel.type != PJSIP_TPSELECTOR_TRANSPORT) {
+        pjsua_init_tpselector(call->acc_id, &tp_sel);
+        pjsip_dlg_set_transport(call->inv->dlg, &tp_sel);
+    }
 }
 
 
@@ -3391,13 +3400,24 @@
         goto on_return;
     }
 
+    /* Honor a caller-supplied PJSUA_CALL_REINIT_MEDIA on the hold path so
+     * that a fresh SRTP master key is generated for the hold re-INVITE.
+     * Cisco Unified CM (TLS/SRTP) silently drops in-dialog re-INVITEs that
+     * reuse the current key (Cisco OL-25254-01 requires a re-key on media
+     * change); stock set_hold2 never re-keys, so the flag would be ignored. */
+    call->opt.flag |= (options & PJSUA_CALL_REINIT_MEDIA);
+
     /* We may need to re-initialize media before creating SDP */
-    if (call->med_prov_cnt == 0) {
+    if (call->med_prov_cnt == 0 ||
+        (call->opt.flag & PJSUA_CALL_REINIT_MEDIA))
+    {
         status = apply_call_setting(call, &call->opt, NULL);
         if (status != PJ_SUCCESS)
             goto on_return;
     }
 
+    call->opt.flag &= ~PJSUA_CALL_REINIT_MEDIA;
+
     status = create_sdp_of_call_hold(call, &sdp);
     if (status != PJ_SUCCESS)
         goto on_return;
