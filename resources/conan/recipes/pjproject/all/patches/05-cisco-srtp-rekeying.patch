diff --git a/pjsip/src/pjsua-lib/pjsua_call.c b/pjsip/src/pjsua-lib/pjsua_call.c
index 9b8e16d..287534f 100644
--- a/pjsip/src/pjsua-lib/pjsua_call.c
+++ b/pjsip/src/pjsua-lib/pjsua_call.c
@@ -3391,13 +3391,24 @@ PJ_DEF(pj_status_t) pjsua_call_set_hold2(pjsua_call_id call_id,
         goto on_return;
     }
 
+    /* Honor a caller-supplied PJSUA_CALL_REINIT_MEDIA on the hold path so
+     * that a fresh SRTP master key is generated for the hold re-INVITE.
+     * Cisco Unified CM (TLS/SRTP) silently drops in-dialog re-INVITEs that
+     * reuse the current key (Cisco OL-25254-01 requires a re-key on media
+     * change); stock set_hold2 never re-keys, so the flag would be ignored. */
+    call->opt.flag |= (options & PJSUA_CALL_REINIT_MEDIA);
+
     /* We may need to re-initialize media before creating SDP */
-    if (call->med_prov_cnt == 0) {
+    if (call->med_prov_cnt == 0 ||
+        (call->opt.flag & PJSUA_CALL_REINIT_MEDIA))
+    {
         status = apply_call_setting(call, &call->opt, NULL);
         if (status != PJ_SUCCESS)
             goto on_return;
     }
 
+    call->opt.flag &= ~PJSUA_CALL_REINIT_MEDIA;
+
     status = create_sdp_of_call_hold(call, &sdp);
     if (status != PJ_SUCCESS)
         goto on_return;
