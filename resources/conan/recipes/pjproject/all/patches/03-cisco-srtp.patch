 /**
+ * Re-key the SRTP transport in place: discard the cached local SDES master
+ * key(s) so that the next SDP offer regenerates fresh crypto material on the
+ * SAME underlying media transport (i.e. the RTP/RTCP ports are preserved).
+ *
+ * This is intended for endpoints that require a fresh SRTP key on every
+ * in-dialog re-INVITE (e.g. Cisco Unified CM secure line-side, which silently
+ * drops a re-INVITE that reuses the current key) but that also reject a
+ * re-INVITE which moves the RTP port -- so a full media re-init
+ * (PJSUA_CALL_REINIT_MEDIA) is not an option.
+ *
+ * The call only affects SDES keying; DTLS-SRTP re-keys through its own
+ * handshake and is left untouched. Passing a transport that is not an SRTP
+ * transport is a harmless no-op.
+ *
+ * @param srtp      The SRTP transport (any transport pointer is accepted; a
+ *                  non-SRTP transport is ignored).
+ *
+ * @return          PJ_SUCCESS on success.
+ */
+PJ_DECL(pj_status_t) pjmedia_transport_srtp_rekey(pjmedia_transport *srtp);
