+/* Re-key SRTP in place on the provisional media transport(s): reset the
+ * cached local SDES master key so the upcoming SDP offer regenerates fresh
+ * crypto on the SAME media transport (keeping the RTP/RTCP ports). This is
+ * the port-preserving alternative to PJSUA_CALL_REINIT_MEDIA, needed by
+ * Cisco Unified CM secure line-side hold/resume. Non-SRTP transports are
+ * ignored by pjmedia_transport_srtp_rekey(). */
+static void call_rekey_srtp(pjsua_call *call)
+{
+    unsigned mi;
+
+    for (mi = 0; mi < call->med_prov_cnt; ++mi) {
+        if (call->media_prov[mi].tp)
+            pjmedia_transport_srtp_rekey(call->media_prov[mi].tp);
+    }
+}
