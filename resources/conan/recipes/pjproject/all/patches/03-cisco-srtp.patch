+/*
+ * Re-key the SRTP transport in place (SDES): drop the cached local master
+ * key(s) so the next SDP offer regenerates fresh crypto on the same media
+ * transport, keeping the RTP/RTCP ports. See transport_srtp.h for rationale.
+ */
+PJ_DEF(pj_status_t) pjmedia_transport_srtp_rekey(pjmedia_transport *tp)
+{
+    transport_srtp  *srtp;
+    unsigned i;
+
+    PJ_ASSERT_RETURN(tp, PJ_EINVAL);
+
+    /* Be tolerant: ignore transports that are not SRTP so the caller can
+     * invoke this on every media transport without pre-checking the type. */
+    if (tp->op != &transport_srtp_op)
+        return PJ_SUCCESS;
+
+    srtp = (transport_srtp*) tp;
+
+    /* Clearing the key length forces generate_crypto_attr_value() (SDES) to
+     * produce a new random master key for the active crypto suite on the next
+     * encode_sdp(). The active tx_policy is left in place so the re-offer
+     * keeps offering the currently negotiated suite (with the fresh key). */
+    for (i = 0; i < srtp->setting.crypto_count; ++i) {
+        srtp->setting.crypto[i].key.ptr = NULL;
+        srtp->setting.crypto[i].key.slen = 0;
+    }
+
+    return PJ_SUCCESS;
+}
+
