diff --git a/pjsip/src/pjsua-lib/pjsua_call.c b/pjsip/src/pjsua-lib/pjsua_call.c
index 9b8e16d..899fa11 100644
--- a/pjsip/src/pjsua-lib/pjsua_call.c
+++ b/pjsip/src/pjsua-lib/pjsua_call.c
@@ -838,9 +838,18 @@ void call_update_contact(pjsua_call *call, pj_str_t **new_contact)
 
     /* When contact is changed, the account transport may have been
      * changed too, so let's update the dialog's transport too.
+     *
+     * Exception: if the dialog has been explicitly pinned to a specific
+     * connection (PJSIP_TPSELECTOR_TRANSPORT, e.g. set by the application so
+     * that in-dialog requests stay on the connection the call was established
+     * on - required by Cisco Unified CM, which advertises a Contact address
+     * that does not resolve to the registered connection), keep that binding
+     * instead of falling back to the account's listener.
      */
-    pjsua_init_tpselector(call->acc_id, &tp_sel);
-    pjsip_dlg_set_transport(call->inv->dlg, &tp_sel);
+    if (call->inv->dlg->tp_sel.type != PJSIP_TPSELECTOR_TRANSPORT) {
+        pjsua_init_tpselector(call->acc_id, &tp_sel);
+        pjsip_dlg_set_transport(call->inv->dlg, &tp_sel);
+    }
 }
 
 
